# Server-only backend origin. Browser requests use the same-origin /api/v1 rewrite.
API_ORIGIN=http://127.0.0.1:8000

# Frontend team review uses sample records by default, including hosted builds.
# Set false and rebuild to disable it before connecting real authentication/data.
NEXT_PUBLIC_LOCAL_ACCESS=true

# SERVER ONLY: required for deployed review sign-in. Never use NEXT_PUBLIC_ names.
# Random secret of at least 32 characters; generate with: openssl rand -base64 48
REVIEW_SESSION_SECRET=
# JSON array: each entry has email, password (12+ characters), role (admin/staff).
# At least one admin required. Configure privately on your host; do not commit values.
REVIEW_ACCOUNTS_JSON=
