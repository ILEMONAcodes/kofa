# Paste Neon pooled connection string here. Never commit backend/.env.
DATABASE_URL=
# Paste Neon direct (unpooled) connection string here; migrations use it.
DATABASE_URL_UNPOOLED=
# Generate a random secret with: openssl rand -base64 48
AUTH_SECRET=
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Development policy versions only; do not publish draft legal text as final.
TERMS_VERSION=draft-v1
PRIVACY_VERSION=draft-v1
POLICIES_APPROVED=false
# Initial admin is created once by the seed-admin command, not public signup.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Kofa Administrator
# No real mail is sent unless SMTP is explicitly configured.
EMAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
