# Paste Neon pooled connection string here. Never commit backend/.env.
DATABASE_URL=
# Paste Neon direct (unpooled) connection string here; migrations use it.
DATABASE_URL_UNPOOLED=
# Generate a random secret with: openssl rand -base64 48
AUTH_SECRET=
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Development policy versions only; do not publish draft legal text as final.
TERMS_VERSION=draft-v1
PRIVACY_VERSION=draft-v1
POLICIES_APPROVED=false
# Initial admin is created once by the seed-admin command, not public signup.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Kofa Administrator
# No real mail is sent unless SMTP is explicitly configured.
EMAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Uploads stay disabled until configured. Local storage is development only.
STORAGE_DRIVER=disabled
STORAGE_LOCAL_ROOT=/tmp/kofa-private-uploads
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FFPROBE_BINARY=ffprobe
# Requires a configured verifier adapter before enabling.
CAPTCHA_REQUIRED=false

# Availability reconfirmation cadence; no automatic unpublication or email.
AVAILABILITY_STALE_DAYS=14

# Assistant: server-managed; requires private provider configuration and live access.
ASSISTANT_PROVIDER=disabled
ASSISTANT_ALLOW_LIVE=false
ASSISTANT_API_URL=
ASSISTANT_API_KEY=
OPENROUTER_API_KEY=
# For OpenRouter set ASSISTANT_PROVIDER=openrouter, ASSISTANT_ALLOW_LIVE=true,
# ASSISTANT_API_URL=https://openrouter.ai/api/v1/chat/completions and OPENROUTER_API_KEY.
# Free-only ordered fallback list (up to three, plus ASSISTANT_MODEL).
ASSISTANT_FALLBACK_MODELS=particle-ai/particle-1:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,cohere/north-mini-code:free
ASSISTANT_MODEL=inclusionai/ling-3.2-flash:free
# Host ceilings cap the code-managed daily allowance; no admin toggle required.
ASSISTANT_HARD_TOKEN_LIMIT=100000
ASSISTANT_DAILY_REQUEST_LIMIT=100
ASSISTANT_DAILY_TOKEN_BUDGET=100000
ASSISTANT_GUEST_DAILY_CONVERSATIONS=5
ASSISTANT_USER_DAILY_CONVERSATIONS=20
ASSISTANT_GUEST_HOURLY_MESSAGES=20
ASSISTANT_USER_HOURLY_MESSAGES=60
ASSISTANT_MAX_OUTPUT_TOKENS=512
